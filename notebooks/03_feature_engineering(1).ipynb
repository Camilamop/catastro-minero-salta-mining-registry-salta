   "source": [
    "---\n",
    "## Sección 3 — Features temporales\n",
    "\n",
    "Dos fuentes de información temporal:\n",
    "- **Histórica (desde `fecha_inic`):** antigüedad, distribución de concesiones por períodos, tasa de crecimiento histórico.\n",
    "- **Entre snapshots:** variación de concesiones entre marzo y agosto 2026 usando `expediente` como clave.\n",
    "\n",
    "**Tratamiento de nulos en `fecha_inic`:** Los registros sin fecha (~4.3%) se excluyen del cálculo de features históricas y se documenta explícitamente. No se imputa para no introducir sesgo temporal."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c5d6e7f8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Features históricas desde fecha_inic\n",
    "con_fecha = base.dropna(subset=['fecha_inic']).copy()\n",
    "sin_fecha = base[base['fecha_inic'].isna()]\n",
    "print(f'Registros con fecha_inic: {len(con_fecha)} | Sin fecha: {len(sin_fecha)} ({len(sin_fecha)/len(base)*100:.1f}%)')\n",
    "\n",
    "con_fecha['anio_inic'] = con_fecha['fecha_inic'].dt.year\n",
    "\n",
    "CORTE_HISTORICO = 2022  # Umbral entre período histórico y período reciente\n",
    "\n",
    "temp_hist = con_fecha.groupby('municipio').agg(\n",
    "    anio_primera_concesion=('anio_inic', 'min'),\n",
    "    n_conc_recientes=('anio_inic', lambda x: (x >= CORTE_HISTORICO).sum()),\n",
    "    n_conc_historicas=('anio_inic', lambda x: (x < CORTE_HISTORICO).sum()),\n",
    "    anio_pico=('anio_inic', lambda x: x.value_counts().idxmax() if len(x) > 0 else np.nan),\n",
    ").reset_index()\n",
    "\n",
    "# Tasa de crecimiento reciente: recientes / históricas\n",
    "# Si históricas == 0, se asigna el total reciente como indicador de municipio nuevo\n",
    "temp_hist['tasa_crecimiento_reciente'] = np.where(\n",
    "    temp_hist['n_conc_historicas'] > 0,\n",
    "    temp_hist['n_conc_recientes'] / temp_hist['n_conc_historicas'],\n",
    "    temp_hist['n_conc_recientes'].astype(float)  # municipio sin historia previa\n",
    ")\n",
    "\n",
    "print(f'\\nFeatures históricas calculadas para {len(temp_hist)} municipios')\n",
    "temp_hist.sort_values('tasa_crecimiento_reciente', ascending=False).head(10)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d6e7f8a9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Features de variación entre snapshots (usando expediente como clave)\n",
    "# Contar concesiones por municipio en cada snapshot\n",
    "conteos_snapshot = {}\n",
    "for mes, gdf in snapshots.items():\n",
    "    conteos_snapshot[mes] = (\n",
    "        gdf.groupby('municipio')['expediente']\n",
    "        .count()\n",
    "        .rename(f'n_conc_{mes}')\n",
    "    )\n",
    "\n",
    "temp_snap = pd.DataFrame(conteos_snapshot).fillna(0).astype(int)\n",
    "temp_snap = temp_snap.reset_index()\n",
    "\n",
    "# Variación absoluta y relativa entre primer y último snapshot\n",
    "temp_snap['var_abs_mar_ago'] = temp_snap['n_conc_agosto'] - temp_snap['n_conc_marzo']\n",
    "temp_snap['var_rel_mar_ago'] = np.where(\n",
    "    temp_snap['n_conc_marzo'] > 0,\n",
    "    temp_snap['var_abs_mar_ago'] / temp_snap['n_conc_marzo'],\n",
    "    temp_snap['n_conc_agosto'].astype(float)\n",
    ")\n",
    "\n",
    "print(f'Variación por municipio entre marzo y agosto 2026:')\n",
    "print(temp_snap.sort_values('var_abs_mar_ago', ascending=False).head(10))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e7f8a9b0",
   "metadata": {},
   "outputs": [],
   "source": [
    "# También: altas (expedientes nuevos) y bajas (expedientes que desaparecen) entre snapshots\n",
    "exp_marzo  = set(snapshots['marzo']['expediente'].dropna())\n",
    "exp_agosto = set(snapshots['agosto']['expediente'].dropna())\n",
    "\n",
    "altas  = exp_agosto - exp_marzo  # concesiones nuevas\n",
    "bajas  = exp_marzo - exp_agosto  # concesiones que salieron\n",
    "\n",
    "print(f'Altas (nuevas concesiones mar→ago): {len(altas)}')\n",
    "print(f'Bajas (concesiones retiradas mar→ago): {len(bajas)}')\n",
    "\n",
    "# Altas por municipio\n",
    "altas_df = snapshots['agosto'][snapshots['agosto']['expediente'].isin(altas)]\n",
    "altas_por_mun = altas_df.groupby('municipio').size().reset_index(name='n_altas_mar_ago')\n",
    "\n",
    "# Bajas por municipio\n",
    "bajas_df = snapshots['marzo'][snapshots['marzo']['expediente'].isin(bajas)]\n",
    "bajas_por_mun = bajas_df.groupby('municipio').size().reset_index(name='n_bajas_mar_ago')\n",
    "\n",
    "print('\\nTop 10 municipios con más altas:')\n",
    "print(altas_por_mun.sort_values('n_altas_mar_ago', ascending=False).head(10))"
   ]
  },
  {
