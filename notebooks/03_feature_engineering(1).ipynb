    "---\n",
    "## Sección 6 — Features a nivel actor (Objetivo B)\n",
    "\n",
    "Tabla separada donde cada fila es un titular único. Es el input para el Isolation Forest del Objetivo B.\n",
    "\n",
    "Un actor con muchas concesiones en pocos departamentos, alta proporción de minerales críticos y crecimiento reciente explosivo tendrá un perfil inusual que el algoritmo puede detectar como anómalo."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e9f0a1b2",
   "metadata": {},
   "outputs": [],
   "source": [
    "actor = base.groupby('concesiona').agg(\n",
    "    total_concesiones=('expediente', 'count'),\n",
    "    sup_total_ha_actor=('area_ha', 'sum'),\n",
    "    municipios_distintos=('municipio', 'nunique'),\n",
    "    departamentos_distintos=('departamen', 'nunique'),\n",
    "    prop_crit_actor=('minerales_criticos', 'mean'),\n",
    "    anio_primera=('fecha_inic', lambda x: x.dt.year.min()),\n",
    "    anio_ultima=('fecha_inic', lambda x: x.dt.year.max()),\n",
    ").reset_index()\n",
    "\n",
    "# Años de actividad\n",
    "actor['anios_actividad'] = actor['anio_ultima'] - actor['anio_primera']\n",
    "actor['anios_actividad'] = actor['anios_actividad'].clip(lower=0)\n",
    "\n",
    "# Tasa de crecimiento de cartera en los últimos 3 años (post 2022)\n",
    "recientes_actor = (\n",
    "    base[base['fecha_inic'].dt.year >= 2022]\n",
    "    .groupby('concesiona').size()\n",
    "    .reset_index(name='conc_recientes_actor')\n",
    ")\n",
    "actor = actor.merge(recientes_actor, on='concesiona', how='left')\n",
    "actor['conc_recientes_actor'] = actor['conc_recientes_actor'].fillna(0).astype(int)\n",
    "actor['tasa_crec_actor'] = np.where(\n",
    "    actor['total_concesiones'] > 0,\n",
    "    actor['conc_recientes_actor'] / actor['total_concesiones'],\n",
    "    0\n",
    ")\n",
    "\n",
    "# Proporción de concesiones vigentes\n",
    "vigentes_actor = (\n",
    "    base[base['estado'].str.lower().str.contains('vigente|activ', na=False)]\n",
    "    .groupby('concesiona').size()\n",
    "    .reset_index(name='n_vigentes_actor')\n",
    ")\n",
    "actor = actor.merge(vigentes_actor, on='concesiona', how='left')\n",
    "actor['n_vigentes_actor'] = actor['n_vigentes_actor'].fillna(0)\n",
    "actor['prop_vigentes_actor'] = actor['n_vigentes_actor'] / actor['total_concesiones']\n",
    "\n",
    "# HHI de la cartera del actor por departamento\n",
    "def hhi_actor(grupo):\n",
    "    total = grupo['area_ha'].sum()\n",
    "    if total == 0:\n",
    "        return np.nan\n",
    "    partic = grupo.groupby('departamen')['area_ha'].sum() / total\n",
    "    return (partic ** 2).sum()\n",
    "\n",
    "hhi_actor_df = base.groupby('concesiona').apply(hhi_actor).reset_index(name='hhi_cartera_dept')\n",
    "actor = actor.merge(hhi_actor_df, on='concesiona', how='left')\n",
    "\n",
    "# Clasificación jurídica/física\n",
    "actor['es_juridica'] = actor['concesiona'].apply(es_persona_juridica)\n",
    "\n",
    "print(f'Tabla de actores: {actor.shape} — {actor[\"concesiona\"].nunique()} titulares únicos')\n",
    "actor.sort_values('total_concesiones', ascending=False).head(10)"
   ]
