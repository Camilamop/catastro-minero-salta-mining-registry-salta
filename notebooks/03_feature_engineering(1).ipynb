    "    conc,\n",
    "    x='n_actores_distintos', y='hhi_superficie',\n",
    "    hover_name='municipio',\n",
    "    size='n_actores_multi_conc',\n",
    "    color='prop_juridicas',\n",
    "    color_continuous_scale='Viridis',\n",
    "    title='HHI vs. Número de actores por municipio',\n",
    "    labels={'hhi_superficie': 'HHI (concentración)', 'n_actores_distintos': 'Actores distintos'}\n",
    ")\n",
    "fig.show()"
   ]
