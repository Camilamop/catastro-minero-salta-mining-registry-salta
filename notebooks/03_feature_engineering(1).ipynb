   "metadata": {},
   "source": [
    "---\n",
    "## Sección 4 — Features de concentración de actores\n",
    "\n",
    "El Índice de Herfindahl-Hirschman (HHI) mide la concentración de mercado. Aplicado a la superficie concesionada por municipio, indica si un territorio está dominado por pocos actores (HHI alto) o distribuido entre muchos (HHI bajo).\n",
    "\n",
    "**Interpretación del HHI:** valores >0.25 indican alta concentración; entre 0.10 y 0.25 concentración moderada; <0.10 baja concentración."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a9b0c1d2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Clasificar titulares: persona jurídica vs. física\n",
    "INDICADORES_JURIDICA = ['S.A.', 'SA ', ' SA', 'S.R.L.', 'SRL', 'INC', 'LTD', 'CORP',\n",
    "                         'S.A.S.', 'SAS', 'S.E.', 'LTDA', 'CIA', 'MINING', 'RESOURCES',\n",
    "                         'LITHIUM', 'MINERA', 'MINAS', 'SOCIEDAD']\n",
    "\n",
    "def es_persona_juridica(nombre):\n",
    "    if pd.isna(nombre):\n",
    "        return np.nan\n",
    "    nombre_up = str(nombre).upper()\n",
    "    return any(ind in nombre_up for ind in INDICADORES_JURIDICA)\n",
    "\n",
    "base['es_juridica'] = base['concesiona'].apply(es_persona_juridica)\n",
    "\n",
    "print('Distribución persona jurídica vs. física:')\n",
    "print(base['es_juridica'].value_counts(dropna=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b0c1d2e3",
   "metadata": {},
   "outputs": [],
   "source": [
    "def calcular_hhi(grupo):\n",
    "    \"\"\"HHI de superficie: suma de cuadrados de participaciones de cada actor.\"\"\"\n",
    "    total = grupo['area_ha'].sum()\n",
    "    if total == 0:\n",
    "        return np.nan\n",
    "    participaciones = grupo.groupby('concesiona')['area_ha'].sum() / total\n",
    "    return (participaciones ** 2).sum()\n",
    "\n",
    "conc = base.groupby('municipio').apply(calcular_hhi).reset_index(name='hhi_superficie')\n",
    "\n",
    "# Resto de features de concentración\n",
    "conc_extra = base.groupby('municipio').agg(\n",
    "    n_actores_distintos=('concesiona', 'nunique'),\n",
    "    prop_juridicas=('es_juridica', 'mean'),\n",
    ").reset_index()\n",
    "\n",
    "# Actores con más de una concesión en el municipio\n",
    "actores_por_mun = base.groupby(['municipio', 'concesiona']).size().reset_index(name='n_conc_actor')\n",
    "multi_actor = (\n",
    "    actores_por_mun[actores_por_mun['n_conc_actor'] > 1]\n",
    "    .groupby('municipio').size()\n",
    "    .reset_index(name='n_actores_multi_conc')\n",
    ")\n",
    "\n",
    "conc = conc.merge(conc_extra, on='municipio', how='left')\n",
    "conc = conc.merge(multi_actor, on='municipio', how='left')\n",
    "conc['n_actores_multi_conc'] = conc['n_actores_multi_conc'].fillna(0).astype(int)\n",
    "\n",
    "print(f'Features de concentración: {conc.shape}')\n",
    "print('\\nTop 10 municipios con mayor HHI (más concentración):')\n",
    "conc.sort_values('hhi_superficie', ascending=False).head(10)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c1d2e3f4",
