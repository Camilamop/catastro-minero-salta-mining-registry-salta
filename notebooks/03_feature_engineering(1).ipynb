    "---\n",
    "## Sección 2 — Features de magnitud territorial\n",
    "\n",
    "Variables que capturan cuánto territorio minero tiene cada municipio en términos absolutos y relativos al snapshot de agosto 2026."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e1f2a3b4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Filtrar solo concesiones vigentes para features de magnitud\n",
    "vigentes = base[base['estado'].str.lower().str.contains('vigente|activ', na=False)].copy()\n",
    "\n",
    "print(f'Concesiones vigentes: {len(vigentes)} de {len(base)} ({len(vigentes)/len(base)*100:.1f}%)')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f2a3b4c5",
   "metadata": {},
   "outputs": [],
   "source": [
    "mag = vigentes.groupby('municipio').agg(\n",
    "    n_concesiones_vigentes=('expediente', 'count'),\n",
    "    sup_total_ha=('area_ha', 'sum'),\n",
    "    sup_crit_ha=('area_ha', lambda x: x[vigentes.loc[x.index, 'minerales_criticos']].sum()),\n",
    "    n_tipos_concesion=('tipo', 'nunique'),\n",
    "    sup_promedio_ha=('area_ha', 'mean'),\n",
    ").reset_index()\n",
    "\n",
    "# Proporción de superficie crítica sobre total\n",
    "mag['prop_sup_crit'] = np.where(\n",
    "    mag['sup_total_ha'] > 0,\n",
    "    mag['sup_crit_ha'] / mag['sup_total_ha'],\n",
    "    0\n",
    ")\n",
    "\n",
    "print(f'Tabla de magnitud: {mag.shape}')\n",
    "mag.sort_values('n_concesiones_vigentes', ascending=False).head(10)"
   ]
